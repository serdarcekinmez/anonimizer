# Python
__pycache__/
*.py[cod]
.venv/
.tools/
.pytest_cache/
.ruff_cache/
.pyright/
.hypothesis/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Personal Claude Code settings and local state
.claude/settings.local.json
.claude/*.local.*
CLAUDE.local.md

# Secrets
.env
.env.*
*.pem
*.key

# Data files are never committed, except registered synthetic fixtures
*.csv
*.tsv
*.xlsx
*.xlsm
*.xls
*.xlsb
*.parquet
*.sqlite
*.db
!tests/fixtures/**
!tests/corpus/**
!tests/adversarial/**

# Local outputs, logs, uncommitted reference snapshots
out/
output/
*.log
docs/compliance/cnil/snapshot/

# Editors and OS
.vscode/
.idea/
.DS_Store

# Placeholders that Claude Code's session sandbox shows inside the working directory to block
# writes to them. They are not project files and cannot be added to git.
/.bash_profile
/.bashrc
/.profile
/.zprofile
/.zshrc
/.gitconfig
/.gitmodules
/.ripgreprc
/.mcp.json
/.idea
/.vscode
/.claude/commands
/.claude/launch.json
/.claude/loop.md
/.claude/output-styles
/.claude/routines
/.claude/scheduled_tasks.json
/.claude/workflows

# machine-specific Windows launcher (names the local WSL distribution and path)
Start-Anonimizer.cmd
